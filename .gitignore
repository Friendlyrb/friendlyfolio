# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# belong in git's global ignore instead:
# `$XDG_CONFIG_HOME/git/ignore` or `~/.config/git/ignore`

# Ignore bundler config.
/.bundle

# Ignore all environment files.
/.env*

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

/public/assets

# Ignore key files for decrypting credentials and more.
/config/*.key


/app/assets/builds/*
!/app/assets/builds/.keep

# Active Storage files and SQLite databases live here; both are gitignored.
# /storage/* above ignores these directories outright, and git cannot
# re-include a file inside an ignored directory -- the directory itself has to
# be un-ignored first. Without this the .keep files are never committed, the
# directories do not exist on a fresh checkout, and the first db:prepare fails.
!/storage/db/
/storage/db/*
!/storage/db/.keep
!/storage/files/
/storage/files/*
!/storage/files/.keep

# Playwright MCP scratch output
/.playwright-mcp/
