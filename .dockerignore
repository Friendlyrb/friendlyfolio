# See https://docs.docker.com/engine/reference/builder/#dockerignore-file for more about ignoring files.

# Git and CI
/.git/
/.gitignore
/.github/

# Agent and editor config
/.agents/
/.claude/
/.cursor/
/AGENTS.md
/CLAUDE.md

# Secrets
/.env*
/config/*.key

# Runtime state: logs, temp files, databases and photos. Never bake these in;
# storage/ is a volume.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep
/tmp/pids/*
!/tmp/pids/.keep
/storage/*
!/storage/.keep
!/storage/db/
/storage/db/*
!/storage/db/.keep
!/storage/files/
/storage/files/*
!/storage/files/.keep

# Built in the image
/public/assets
/app/assets/builds/*
!/app/assets/builds/.keep

# Not needed at runtime
/test/
/docs/
/.playwright-mcp/
/compose.yaml
/Dockerfile
