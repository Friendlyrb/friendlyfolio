<%#
  Present on the gallery page and on every section page, so a section is never
  a dead end -- the reference keeps the same folder nav on every view, and
  arriving at a section from a shared link is the common case.
%>
<nav class="sections-nav" aria-label="Sections in <%= gallery.title %>">
  <%# One step back, wherever that is: a section returns to its gallery, and the
      gallery itself returns to the index. Pointing this at the gallery
      unconditionally made it a link to the page you were already on. %>
  <a class="sections-nav__back" href="<%= current ? gallery_path(gallery) : root_path %>">
    <span aria-hidden="true">&#8249;</span> <%= current ? gallery.title : "All editions" %>
  </a>

  <% if gallery.sections.size > 1 %>
    <span class="sections-nav__links">
      <% gallery.sections.each do |section| %>
        <a href="<%= gallery_section_path(gallery, section) %>"
           <%= 'aria-current="page"'.html_safe if section == current %>><%= section.title %></a>
      <% end %>
    </span>
  <% end %>
</nav>
