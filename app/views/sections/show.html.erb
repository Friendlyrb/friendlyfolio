<%# A photo deep link is its own page: it unfurls as that photo and is its
    own canonical. A section's later pages keep their ?page= in the canonical,
    since each holds different photos. %>
<% seo title: (@photo ? "Photo from #{@section.title}, #{@gallery.title}" : "#{@section.title}, #{@gallery.title} photos"),
       description: @section.description.presence || @gallery.description.presence ||
         "#{pluralize(@section.photos_count, "photo")} from #{@section.title} at #{@gallery.title}.",
       page_type: (@photo ? "WebPage" : "ImageGallery"),
       image: @photo || @section.photos.displayable.first,
       image_alt: "#{@section.title}. #{@gallery.title}",
       canonical_path: (@photo ? gallery_section_photo_path(@gallery, @section, @photo) :
                         gallery_section_path(@gallery, @section, page: (@page if @page.to_i > 1))),
       breadcrumbs: [ [ "Photo galleries", root_path ], [ @gallery.title, gallery_path(@gallery) ],
                      [ @section.title, gallery_section_path(@gallery, @section) ] ],
       robots: ("noindex, nofollow" unless @gallery.published?) %>

<%#
  Two shapes from one action. The gallery page pulls each section in through a
  turbo-frame, which wants the wall and nothing else; a visitor arriving at the
  section's own URL wants a page they can navigate out of. Without the second
  shape a shared section link is a dead end -- a wall with no title and no way
  back to the gallery it belongs to.
%>
<% if turbo_frame_request? %>
  <%= render "sections/frame", gallery: @gallery, section: @section, photos: @photos, page: @page, photo: @photo %>
<% else %>
  <article class="gallery" style="--accent: <%= gallery_accent(@gallery) %>">
    <%= render "galleries/cover", gallery: @gallery, section: @section %>

    <section class="gallery-section">
      <h2><%= @section.title %></h2>
      <% if @section.description.present? %>
        <p class="section-description"><%= @section.description %></p>
      <% end %>

      <%= render "sections/frame", gallery: @gallery, section: @section, photos: @photos, page: @page, photo: @photo %>
    </section>

    <% if @gallery.photographer.present? %>
      <footer class="credit">Photos by <%= @gallery.photographer %></footer>
    <% end %>
  </article>
<% end %>
