<% content_for :title, "#{@section.title} — #{@gallery.title}" %>
<% if @photo %>
  <%# The JPEG tier deliberately: unfurlers on Slack, LinkedIn and X do not
      decode AVIF, so an AVIF og:image renders as nothing. %>
  <% content_for :og_image, photo_variant_url(@photo, :share_jpeg) %>
  <% content_for :og_title, "#{@section.title} — #{@gallery.title}" %>
<% elsif (cover = @section.photos.displayable.first) %>
  <% content_for :og_image, photo_variant_url(cover, :share_jpeg) %>
<% end %>
<% if @gallery.description.present? %>
  <% content_for :og_description, @gallery.description %>
<% end %>

<%#
  Two shapes from one action. The gallery page pulls each section in through a
  turbo-frame, which wants the wall and nothing else; a visitor arriving at the
  section's own URL wants a page they can navigate out of. Without the second
  shape a shared section link is a dead end -- a wall with no title and no way
  back to the gallery it belongs to.
%>
<% if turbo_frame_request? %>
  <%= render "sections/frame", gallery: @gallery, section: @section, photos: @photos, page: @page, photo: @photo %>
<% else %>
  <article class="gallery">
    <%= render "galleries/cover", gallery: @gallery %>
    <%= render "sections/nav", gallery: @gallery, current: @section %>

    <section class="gallery-section">
      <h2><%= @section.title %></h2>
      <% if @section.description.present? %>
        <p class="section-description"><%= @section.description %></p>
      <% end %>

      <%= render "sections/frame", gallery: @gallery, section: @section, photos: @photos, page: @page, photo: @photo %>
    </section>

    <% if @gallery.photographer.present? %>
      <footer class="credit">Photos by <%= @gallery.photographer %></footer>
    <% end %>
  </article>
<% end %>
