<% content_for :title, "#{@section.title} — #{@gallery.title}" %>
<% if @photo %>
  <%# The JPEG tier deliberately: unfurlers on Slack, LinkedIn and X do not
      decode AVIF, so an AVIF og:image renders as nothing. %>
  <% content_for :og_image, photo_variant_url(@photo, :share_jpeg) %>
  <% content_for :og_title, "#{@section.title} — #{@gallery.title}" %>
<% elsif (cover = @section.photos.displayable.first) %>
  <% content_for :og_image, photo_variant_url(cover, :share_jpeg) %>
<% end %>
<% if @gallery.description.present? %>
  <% content_for :og_description, @gallery.description %>
<% end %>

<%#
  Wrapped in a matching turbo-frame because the gallery page loads every
  section after the first through one. Without an element whose id matches
  dom_id(section), Turbo finds nothing to swap in and the section renders
  "Content missing" -- which is most of the corpus.
%>
<%= turbo_frame_tag dom_id(@section) do %>
  <div data-controller="lightbox"
       data-lightbox-section-path-value="<%= gallery_section_path(@gallery, @section) %>">
    <%= render "sections/wall", photos: @photos, gallery: @gallery, section: @section %>

    <% if @section.paginated? %>
      <nav class="pagination" aria-label="<%= @section.title %> pages">
        <% (1..@section.page_count).each do |n| %>
          <%# Real links, so the pages work without JavaScript and can be crawled. %>
          <a href="<%= gallery_section_path(@gallery, @section, page: n) %>"
             <%= "aria-current=\"page\"".html_safe if n == @page %>><%= n %></a>
        <% end %>
      </nav>
    <% end %>

    <%= render "photos/lightbox", gallery: @gallery, section: @section, photos: @photos, open_photo: @photo, page: @page %>
  </div>
<% end %>
