<%= turbo_frame_tag dom_id(section), data: { turbo_action: "advance" } do %>
<div data-controller="lightbox"
     data-lightbox-section-path-value="<%= request.path %>">
  <% photos = section.photos.displayable.with_images.limit(Section::PER_PAGE) %>
  <%= render "sections/wall", photos: photos, gallery: gallery, section: section %>
  <% if section.paginated? %>
    <nav class="pagination" aria-label="<%= section.title %> pages">
      <% (1..section.page_count).each do |n| %>
        <a href="<%= gallery_section_path(gallery, section, page: n) %>" <%= "aria-current=\"page\"".html_safe if n == 1 %>><%= n %></a>
      <% end %>
    </nav>
  <% end %>
  <%= render "photos/lightbox", gallery: gallery, section: section, photos: photos, open_photo: nil, page: 1 %>
</div>
<% end %>
