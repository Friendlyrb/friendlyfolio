<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= page_title %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%# Only for the admin. On public pages the session is skipped so the
        response stays edge-cacheable, and a token a skipped session can never
        validate is worse than no token. Any future public form needs this
        reconsidered -- it would 422 silently. %>
    <% if admin_signed_in? %>
      <%= csrf_meta_tags %>
    <% end %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Social cards. og:image is the JPEG variant deliberately: unfurlers on
        Slack, LinkedIn and X do not decode AVIF. %>
    <meta property="og:title" content="<%= content_for(:og_title) || content_for(:title) || "Friendly.rb photos" %>">
    <meta property="og:description" content="<%= content_for(:og_description) || "Conference photos from Friendly.rb." %>">
    <meta property="og:type" content="website">
    <meta property="og:url" content="<%= request.original_url %>">
    <% if content_for?(:og_image) %>
      <meta property="og:image" content="<%= content_for(:og_image) %>">
      <meta name="twitter:image" content="<%= content_for(:og_image) %>">
    <% end %>
    <meta name="twitter:card" content="summary_large_image">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Work+Sans:wght@400;600&family=Sora:wght@600;700&display=swap">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <% if notice %><p class="notice"><%= notice %></p><% end %>
    <% if alert %><p class="alert"><%= alert %></p><% end %>
    <%= yield %>
  </body>
</html>
