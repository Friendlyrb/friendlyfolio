<% cover_gallery = @galleries.find(&:cover) %>
<% seo page_type: "CollectionPage",
       image: cover_gallery&.cover,
       image_alt: cover_gallery && "#{cover_gallery.title} cover photo" %>

<header class="page-header">
  <p class="eyebrow">Relive it</p>
  <h1>Photo galleries</h1>
  <p class="lede">Every edition, every day, every hallway conversation someone pointed a camera at.</p>
</header>

<ul class="gallery-index" data-controller="blurhash">
  <% @galleries.each do |gallery| %>
    <li class="gallery-card" style="--accent: <%= gallery_accent(gallery) %>">
      <a href="<%= gallery_path(gallery) %>">
        <span class="gallery-card__cover"
              style="background: <%= gallery.cover&.dominant_color || "#012B7F" %>"
              <%= tag.attributes(data: { blurhash: gallery.cover&.blurhash }) if gallery.cover&.blurhash.present? %>>
          <% if gallery.cover %>
            <%= render "photos/picture",
                       photo: gallery.cover,
                       variants: %i[wall_avif wall_webp],
                       sizes: "(max-width: 700px) 100vw, 50vw",
                       eager: true,
                       alt: "#{gallery.title} cover photo" %>
          <% end %>
        </span>
        <span class="gallery-card__body">
          <span class="gallery-card__title"><%= gallery.title %> <span class="gallery-card__arrow" aria-hidden="true">&rarr;</span></span>
          <span class="gallery-card__meta">
            <% if gallery.held_on %><time datetime="<%= gallery.held_on.iso8601 %>"><%= gallery.held_on.strftime("%-d %B %Y") %></time> &middot; <% end %>
            <%= pluralize gallery.photos_count, "photo" %>
          </span>
        </span>
      </a>
    </li>
  <% end %>
</ul>

<% if @galleries.empty? %>
  <p class="empty">No galleries published yet.</p>
<% end %>
