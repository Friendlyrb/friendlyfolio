<% content_for :title, @gallery.title %>
<% if @gallery.cover %>
  <% content_for :og_image, photo_variant_url(@gallery.cover, :share_jpeg) %>
<% end %>
<% if @gallery.description.present? %>
  <% content_for :og_description, @gallery.description %>
<% end %>

<% if admin_signed_in? && !@gallery.published? %>
  <%#
    The page itself is marked private, but the images are not: Active Storage
    answers every representation request with a permanent public URL and a
    year-long immutable cache directive, whoever asked. Previewing an
    unpublished gallery from the deployed box therefore pushes its full-size
    bytes into the CDN at URLs that keep working after publication is revoked.
    Preview on a laptop instead. See README, "Publication is a one-way door".
  %>
  <p class="admin-warning" role="status">
    <strong>Unpublished preview.</strong>
    Only you can see this page — but the photos on it are served at permanent
    public URLs. Previewing from the deployed site pushes them into the CDN,
    where they stay reachable even after you unpublish. Review locally instead.
  </p>
<% end %>

<article class="gallery">
  <%= render "galleries/cover", gallery: @gallery %>

  <%= render "sections/nav", gallery: @gallery, current: nil %>

  <% @sections.each_with_index do |section, index| %>
    <section class="gallery-section" id="section-<%= section.slug %>">
      <% if @sections.size > 1 %>
        <h2><%= link_to section.title, gallery_section_path(@gallery, section) %></h2>
      <% end %>
      <% if section.description.present? %>
        <p class="section-description"><%= section.description %></p>
      <% end %>

      <% if index.zero? %>
        <%= render "sections/frame",
                   gallery: @gallery,
                   section: section,
                   photos: section.photos.displayable.with_attached_image.limit(Section::PER_PAGE),
                   page: 1,
                   photo: nil %>
      <% else %>
        <%#
          Later sections load lazily. The reserved height matters: an unloaded
          frame is zero-height, so without it every arriving section shoves the
          page down and reintroduces the layout shift the wall avoids.
        %>
        <%= turbo_frame_tag dom_id(section),
                            src: gallery_section_path(@gallery, section),
                            loading: :lazy,
                            style: "display:block; min-height: #{reserved_height(section)}px" do %>
          <div class="wall-placeholder" aria-hidden="true"></div>
        <% end %>
      <% end %>
    </section>
  <% end %>

  <% if @gallery.photographer.present? %>
    <footer class="credit">Photos by <%= @gallery.photographer %></footer>
  <% end %>
</article>
