<header class="cover" style="background: <%= gallery.cover&.dominant_color || "#012B7F" %>">
  <% if gallery.cover %>
    <%= render "photos/picture",
               photo: gallery.cover,
               variants: %i[large_avif large_webp],
               sizes: "100vw",
               eager: true,
               alt: "#{gallery.title} cover photo" %>
  <% end %>
  <%# The scrim is not decoration: the title sits over whichever photo the
      admin picked, and without it a bright cover makes it unreadable. %>
  <div class="cover__scrim"></div>
  <div class="cover__text">
    <% if gallery.held_on %>
      <time datetime="<%= gallery.held_on.iso8601 %>"><%= gallery.held_on.strftime("%-d %B %Y") %></time>
    <% end %>
    <%# A section page names its section in the heading for screen readers and
        search engines, so no two pages share an h1; the visible h2 below the
        nav already says it on screen. %>
    <h1><%= gallery.title %><% if local_assigns[:section] %><span class="visually-hidden">: <%= section.title %></span><% end %></h1>
  </div>
</header>
