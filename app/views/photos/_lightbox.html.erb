<%#
  Native <dialog>. showModal() provides the top layer, the backdrop, Escape to
  close, focus containment via inert, and implicit aria-modal -- so most of the
  accessibility requirement is the element's job, not the controller's.
  Never add tabindex to it.
%>
<dialog class="lightbox"
        data-lightbox-target="dialog"
        aria-label="Photo viewer"
        data-action="click->lightbox#backdropClose keydown->lightbox#key close->lightbox#closed">
  <figure class="lightbox__figure" data-lightbox-target="figure">
    <%# Holds the photo's exact box in its dominant colour until the bytes
        arrive -- the same trick a wall tile uses. %>
    <div class="lightbox__placeholder" data-lightbox-target="placeholder" aria-hidden="true"></div>
    <%# Both sources are swapped by the controller. Without the <source>, the
        AVIF tier is encoded for every photo and then never delivered. %>
    <picture>
      <source type="image/avif" data-lightbox-target="avif">
      <img data-lightbox-target="image" alt="" decoding="async" fetchpriority="high">
    </picture>
  </figure>

  <div class="lightbox__bar">
    <span class="lightbox__counter" data-lightbox-target="counter" aria-live="polite"></span>

    <div class="lightbox__actions">
      <a class="btn" data-lightbox-target="download" download>Download original</a>
      <a class="btn" data-lightbox-target="share2048" download>Download for sharing</a>

      <button class="btn"
              type="button"
              data-controller="share"
              data-action="share#copy"
              data-share-target="button">
        <span data-share-target="label">Copy link</span>
      </button>

      <button class="btn btn--close" type="button" autofocus data-action="lightbox#close" aria-label="Close viewer">&times;</button>
    </div>
  </div>

  <button class="lightbox__nav lightbox__nav--prev" type="button" data-action="lightbox#prev" aria-label="Previous photo">&#8249;</button>
  <button class="lightbox__nav lightbox__nav--next" type="button" data-action="lightbox#next" aria-label="Next photo">&#8250;</button>
</dialog>

<script type="application/json" data-lightbox-target="manifest">
  <%= raw({
        photos: photos.map do |p|
          {
            id: p.id,
            avif: photo_variant_url(p, :zoom_avif),
            webp: photo_variant_url(p, :zoom_webp),
            large: photo_variant_url(p, :large_webp),
            url: gallery_section_photo_path(gallery, section, p),
            download: download_gallery_section_photo_path(gallery, section, p),
            share: download_gallery_section_photo_path(gallery, section, p, size: "share"),
            alt: "#{section.title}. #{gallery.title}",
            r: p.aspect_ratio,
            color: p.dominant_color
          }
        end,
        open: open_photo&.id,
        nextPage: (n = section.first_photo_on(page.to_i + 1)) && gallery_section_photo_path(gallery, section, n),
        prevPage: (p = section.last_photo_on(page.to_i - 1)) && gallery_section_photo_path(gallery, section, p)
      }.to_json) %>
</script>
