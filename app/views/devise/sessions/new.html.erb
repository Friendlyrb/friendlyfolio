<% content_for :title, "Sign in" %>

<%#
  Pre-filled in development only. These are the same defaults db/seeds.rb
  creates, so a fresh checkout can get into the admin without going to look
  them up. Production renders the fields empty -- it has no default admin.
%>
<% prefill = Rails.env.local? %>

<div class="signin">
  <h1>Sign in</h1>

  <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "signin__form" }) do |f| %>
    <label class="signin__field">
      <span>Email</span>
      <%= f.email_field :email,
                        value: (prefill ? "adrian@adrianthedev.com" : nil),
                        autofocus: true,
                        autocomplete: "email" %>
    </label>

    <label class="signin__field">
      <span>Password</span>
      <%= f.password_field :password,
                           value: (prefill ? "secreto" : nil),
                           autocomplete: "current-password" %>
    </label>

    <% if devise_mapping.rememberable? %>
      <label class="signin__remember">
        <%= f.check_box :remember_me %>
        <span>Stay signed in</span>
      </label>
    <% end %>

    <%= f.submit "Sign in", class: "btn btn--go" %>
  <% end %>

  <% if prefill %>
    <p class="signin__hint">
      Development credentials are filled in for you. Production has no default
      admin — set <code>ADMIN_EMAIL</code> and <code>ADMIN_PASSWORD</code> there.
    </p>
  <% end %>
</div>
