<% content_for :title, "Import photos" %>

<div class="importer"
     data-controller="importer"
     data-importer-url-value="<%= admin_imports_path %>"
     data-importer-direct-upload-url-value="<%= rails_direct_uploads_path %>">

  <h1>Import photos</h1>

  <label class="importer__field">
    <span>Gallery</span>
    <select data-importer-target="gallery">
      <% @galleries.each do |gallery| %>
        <option value="<%= gallery.slug %>"><%= gallery.title %> (<%= gallery.slug %>)</option>
      <% end %>
    </select>
  </label>

  <p class="importer__hint">
    Drop a folder below. Each subfolder becomes a section — a file arriving as
    <code>day-1/DSC_0001.jpg</code> lands in a section called <code>day-1</code>,
    created if it does not exist. Files dropped loose go into a section called
    <code>photos</code>.
  </p>

  <div class="importer__drop"
       data-importer-target="drop"
       data-action="dragover->importer#over dragleave->importer#leave drop->importer#drop">
    <p><strong>Drop a folder here</strong></p>
    <p class="importer__or">or</p>
    <%# webkitdirectory is what turns a file picker into a folder picker. %>
    <input type="file"
           multiple
           webkitdirectory
           data-importer-target="input"
           data-action="change->importer#picked">
  </div>

  <div class="importer__status" data-importer-target="status" role="status" aria-live="polite"></div>

  <ul class="importer__plan" data-importer-target="plan"></ul>

  <button class="btn btn--go"
          type="button"
          hidden
          data-importer-target="start"
          data-action="importer#start">Import</button>

  <details class="importer__note">
    <summary>Importing a whole edition?</summary>
    <p>
      This uploads to the server and bakes there — roughly 12 seconds of CPU per
      photo, so a 700-photo edition is about two hours of the box's time while
      the site is serving. That is fine for tens of photos and a poor trade for
      hundreds.
    </p>
    <p>
      For a full edition, ingest and bake on a laptop and copy the result up.
      See <code>photos:ingest</code> in the README.
    </p>
    <p>
      Either way, strip GPS first — photos carrying location data are rejected,
      because the download button hands out the original file:
      <code>exiftool -gps:all= -overwrite_original_in_place -r &lt;dir&gt;</code>
    </p>
  </details>
</div>
